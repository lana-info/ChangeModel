# Скопируйте этот файл в proxy/.env и впишите свои ключи.
# Формат: ИМЯ=значение, по одной строке, без кавычек и инлайн-комментариев.
# Прокси перечитывает файл автоматически по времени изменения — ключи можно
# менять без перезапуска. Переменные окружения используются как запасной
# вариант, если ключа нет здесь.
#
# Copy this file to proxy/.env and fill in your keys. The proxy hot-reloads it.

OPENROUTER_API_KEY=
OPENCODE_GO_API_KEY=
OPENCODE_ZEN_API_KEY=
GMI_API_KEY=
AGENTROUTER_API_KEY=
